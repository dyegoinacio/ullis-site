{
  "rewrites": [
    { "source": "/quem-somos",       "destination": "/quem-somos.html" },
    { "source": "/proteses",          "destination": "/proteses.html" },
    { "source": "/orteses",           "destination": "/orteses.html" },
    { "source": "/avaliacao-gratuita","destination": "/avaliacao-gratuita.html" },
    { "source": "/blog",              "destination": "/blog.html" },
    { "source": "/unidades",          "destination": "/unidades.html" },
    { "source": "/doacao-protese",    "destination": "/doacao-protese.html" }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
